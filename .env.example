# ============================================================================
# Copy to `.env.local` for development. Never commit a real `.env` file.
# Every value below is a placeholder — fill these in before deploying.
#
# This file contains variable NAMES and safe placeholders only.
# Actual secret values belong in your deployment platform's environment settings,
# never here and never in OWNER_CONFIG.md.
# ============================================================================

# --- Site -------------------------------------------------------------------
# Canonical public origin. Used for metadata, canonical URLs, sitemap and robots.
# In production this MUST be your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inquiry email provider -------------------------------------------------
# Which adapter delivers project inquiries.
#
#   "console" -> prints the rendered email to the server log (development only)
#   "resend"  -> sends via the Resend REST API (production)
#
# DEVELOPMENT: leave unset or set "console". Nothing else is required.
# PRODUCTION:  MUST be "resend". The console adapter refuses to run when
#              NODE_ENV=production, and a missing provider fails inquiries
#              safely rather than pretending to deliver them.
EMAIL_PROVIDER=console

# --- Resend (only read when EMAIL_PROVIDER=resend) ---------------------------
# API key from https://resend.com. Secret — never commit, never expose to the client.
# Optional in development: the build and local dev work without it.
RESEND_API_KEY=

# Destination inbox that receives project inquiries.
# NOTE: this is the INTERNAL delivery inbox. It is never shown on the public
# site. The public contact address is configured separately in
# src/lib/content.ts (site.email).
INQUIRY_TO_EMAIL=

# Verified sender address. Resend rejects unknown senders, and the domain must be
# verified in your Resend account.
# The visitor's address is used as Reply-To, never as the sender.
INQUIRY_FROM_EMAIL=

# --- Rate limiting: persistent backend (REQUIRED IN PRODUCTION) --------------
# Upstash Redis over its REST API. Implemented with native fetch — no SDK.
#
# PRODUCTION: both values are required. Without them the inquiry endpoint
# REFUSES submissions with HTTP 503 rather than running unprotected.
#
# DEVELOPMENT: leave unset — the in-memory limiter is used automatically.
#
# Never expose either value with a NEXT_PUBLIC_ prefix; that would ship it to
# the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash request timeout in milliseconds (default 2000).
# RATE_LIMIT_UPSTASH_TIMEOUT_MS=2000

# --- Rate limiting: policy ---------------------------------------------------
# Requests allowed per window, per identifier. Default: 5 per 10 minutes.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Failure policy when the persistent limiter cannot be reached.
#
#   unset / "false" -> FAIL CLOSED (default, recommended). The inquiry is
#                      refused with HTTP 503 and a generic message. An outage
#                      never silently becomes unlimited access.
#   "true"          -> FAIL OPEN. The request proceeds and the bypass is logged
#                      on every occurrence. Only choose this when losing a real
#                      inquiry is worse than the extra spam exposure, and pair
#                      it with a CAPTCHA or upstream filter.
RATE_LIMIT_FAIL_OPEN=false

# --- Environment ------------------------------------------------------------
NODE_ENV=development